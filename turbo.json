{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["XDG_*", "MISE_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/chrome-mv3/**", "dist/**"]
    },
    "build:firefox": {
      "outputs": [".output/firefox-mv3/**"]
    },
    "lint:webext": {
      "dependsOn": ["build:firefox"]
    },
    "test": {},
    "typecheck": {},
    "//#dead-code": {},
    "//#format": {},
    "//#lint": {},
    "//#lint:actions": {
      "inputs": [".github/workflows/**"]
    },
    "//#lint:md": {
      "inputs": ["**/*.md", ".markdownlint-cli2.jsonc"]
    },
    "//#lint:yaml": {
      "inputs": ["**/*.{yml,yaml}", ".yamllint.yaml"]
    },
    "//#secrets": {},
    "//#spell": {}
  }
}
