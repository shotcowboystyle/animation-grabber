{
  "name": "@animation-grabber/extension",
  "version": "0.2.1",
  "private": true,
  "description": "Browser extension that grabs GSAP animations from any page that uses GSAP",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint:webext": "web-ext lint --warnings-as-errors --source-dir .output/firefox-mv3",
    "react-doctor": "react-doctor . --verbose"
  },
  "dependencies": {
    "@animation-grabber/core": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "react-doctor": "0.9.17",
    "typescript": "^7.0.2",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}
