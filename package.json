{
  "name": "animation-grabber-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Grab GSAP animations from any page that uses GSAP: browser extension, CLI and agent skill",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "dead-code": "fallow dead-code",
    "spell": "cspell --no-progress \"**\"",
    "lint:md": "markdownlint-cli2",
    "lint:yaml": "yamllint -s .",
    "lint:actions": "actionlint",
    "secrets": "betterleaks dir . --no-banner --redact",
    "check": "turbo run typecheck test //#lint //#format //#dead-code //#spell //#lint:md //#lint:yaml //#lint:actions //#secrets",
    "fix": "ultracite fix",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "cspell": "10.3.6",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-plugin-react-doctor": "^0.9.16",
    "turbo": "2.11.7",
    "typescript": "^7.0.2",
    "ultracite": "7.12.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1"
}
